{% extends 'base.html.twig' %}

{% block title %}{{ player.displayName }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# Progress changes after every round; never show a stale copy from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <h1>{{ 'player.show.title'|trans({'%name%': player.displayName}) }}</h1>

    {% if is_new %}
        <p class="notice notice--success">{{ 'player.show.created'|trans }}</p>
    {% endif %}

    <section class="player-card" data-controller="clipboard"
        data-clipboard-copied-value="{{ 'player.link.copied'|trans }}"
        data-clipboard-failed-value="{{ 'player.link.copy_failed'|trans }}">
        <h2>{{ 'player.link.title'|trans }}</h2>
        <p>{{ 'player.link.intro'|trans }}</p>
        {# Not a link on purpose: following it would only re-login, and Turbo may prefetch links. #}
        <div class="player-link">
            <label class="visually-hidden" for="player-link">{{ 'player.link.title'|trans }}</label>
            <input type="text" id="player-link" class="player-link__url" value="{{ link }}" readonly
                data-clipboard-target="source" data-action="focus->clipboard#select">
            <button type="button" class="action-button" data-action="clipboard#copy">{{ 'player.link.copy'|trans }}</button>
        </div>
        <p class="player-link__status" role="status" data-clipboard-target="status"></p>
        <p class="player-link__warning">{{ 'player.link.warning'|trans }}</p>
    </section>

    {# Whole minutes played in finished rounds of the last seven days (PracticeTime). #}
    <p class="practice-time">
        <span aria-hidden="true">⏱️</span>
        {% if practice_minutes == 0 %}
            {{ 'player.practice.zero'|trans }}
        {% elseif practice_minutes == 1 %}
            {{ 'player.practice.one'|trans }}
        {% else %}
            {{ 'player.practice.many'|trans({'%minutes%': practice_minutes}) }}
        {% endif %}
    </p>

    <section class="player-card">
        <h2>{{ 'player.progress.title'|trans }}</h2>
        <ul class="progress-list">
            {# Tables 1–12 first, then the "alle tafels" mixes (stored under their own table number). #}
            {% set rows = tables|map(table => {table: table, label: 'game.rekenen.table'|trans({'%table%': table})})
                |merge(mixes|map(mix => {table: mix.value, label: 'game.rekenen.mixes.range'|trans({'%last%': mix.lastTable})})) %}
            {% for row in rows %}
                {% set result = progress[row.table] ?? null %}
                <li class="progress-list__item">
                    <span class="progress-list__table">{{ row.label }}</span>
                    {% if result is null %}
                        <span class="progress-list__status">{{ 'player.progress.not_yet'|trans }}</span>
                    {% else %}
                        {{ include('player/_progress_badge.html.twig', {result: result}) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <a class="action-button" href="{{ path('app_game_rekenen_tafels') }}">{{ 'player.progress.play'|trans }}</a>
    </section>

    <section class="player-card" id="erbij-eraf">
        <h2>{{ 'player.progress.erbij_eraf_title'|trans }}</h2>
        {{ include('player/_level_table.html.twig', {
            grid: erbij_eraf_grid,
            progress: erbij_eraf_progress,
            column: 'operation',
            column_keys: 'game.rekenen.erbij_eraf.operations.',
            level_keys: 'game.rekenen.erbij_eraf.levels.',
        }, with_context = false) }}
        <a class="action-button" href="{{ path('app_game_rekenen_erbij_eraf') }}">{{ 'player.progress.erbij_eraf_play'|trans }}</a>
    </section>

    <section class="player-card" id="dictee">
        <h2>{{ 'player.progress.dictee_title'|trans }}</h2>
        {{ include('player/_level_table.html.twig', {
            grid: dictee_grid,
            progress: dictee_progress,
            column: 'group',
            column_keys: 'game.taal.dictee.groups.',
            level_keys: 'game.taal.dictee.levels.',
        }, with_context = false) }}
        <a class="action-button" href="{{ path('app_game_taal_dictee') }}">{{ 'player.progress.dictee_play'|trans }}</a>
    </section>

    <section class="player-card">
        <h2>{{ 'player.logout.title'|trans }}</h2>
        <p>{{ 'player.logout.intro'|trans }}</p>
        <form method="post" action="{{ logout_path('main') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" data-controller="csrf-protection">
            <button type="submit" class="action-button action-button--secondary">{{ 'player.logout.submit'|trans }}</button>
        </form>
    </section>
{% endblock %}
