{#
    Best result for one level (table, mix, erbij-en-eraf level): ⭐ within the time limit, ✓ completed but slower.
    compact: only icon + time visible (picker tiles); the full sentence stays for screen readers.
#}
{% set label = (result.passed ? 'player.progress.passed' : 'player.progress.done')|trans({'%within%': result.withinKey|trans, '%time%': result.bestTime}) %}
<span class="progress-badge progress-badge--{{ result.passed ? 'passed' : 'done' }}">
    <span aria-hidden="true">{{ result.passed ? '⭐' : '✓' }}</span>
    {% if compact|default(false) %}
        <span class="visually-hidden">{{ label }}</span>
        <span aria-hidden="true">{{ result.bestTime }}</span>
    {% else %}
        {{ label }}
    {% endif %}
</span>
