{% extends 'base.html.twig' %}

{# A task selection screen: the elephant mascot sits in the bottom right corner. #}
{% set mascot = true %}

{% block title %}{{ 'game.rekenen.tafels.name'|trans }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# Badges change after every round; never show a stale copy from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <h1>{{ 'game.rekenen.tafels.name'|trans }}</h1>
    <p>{{ 'game.rekenen.tafels.picker_intro'|trans }}</p>

    <ul class="table-picker">
        {% for table in tables %}
            {{ include('game/_picker_tile.html.twig', {
                url: path('app_game_rekenen_tafel', {table: table}),
                label: 'game.rekenen.table'|trans({'%table%': table}),
                result: progress[table] ?? null,
            }, with_context = false) }}
        {% endfor %}
        <li class="table-picker__item--all">
            <a class="table-picker__link table-picker__link--all" href="{{ path('app_game_rekenen_alle') }}">
                <span class="table-picker__label">{{ 'game.rekenen.all_tables'|trans }}</span>
            </a>
        </li>
    </ul>

    <p class="table-picker__back">
        <a class="action-button action-button--secondary action-button--small" href="{{ path('app_game_rekenen') }}">
            <span aria-hidden="true">←</span> {{ 'game.rekenen.back'|trans }}
        </a>
    </p>
{% endblock %}
