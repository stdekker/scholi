{% extends 'base.html.twig' %}

{# A task selection screen: the elephant mascot sits in the bottom right corner. #}
{% set mascot = true %}

{#
    Two simple choices on one page: first erbij / eraf / door elkaar (links that reload the page
    with ?soort=…, so no JS is needed), then one of the six levels for that choice.
#}
{% set symbols = {erbij: '+', eraf: '−', 'door-elkaar': '+ −'} %}
{% set example_keys = {erbij: 'example_plus', eraf: 'example_min', 'door-elkaar': 'example'} %}

{% block title %}{{ 'game.rekenen.erbij_eraf.name'|trans }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# Badges change after every round; never show a stale copy from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <h1>{{ 'game.rekenen.erbij_eraf.name'|trans }}</h1>

    <h2 class="picker-step">{{ 'game.rekenen.erbij_eraf.choose_operation'|trans }}</h2>
    <ul class="operation-switch">
        {% for choice in operations %}
            <li>
                <a class="operation-switch__link" href="{{ path('app_game_rekenen_erbij_eraf', {soort: choice.value}) }}"
                    {%- if choice == operation %} aria-current="page"{% endif %}>
                    <span class="operation-switch__symbol" aria-hidden="true">{{ symbols[choice.value] }}</span>
                    {{ ('game.rekenen.erbij_eraf.operations.' ~ choice.key)|trans }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <h2 class="picker-step">{{ 'game.rekenen.erbij_eraf.choose_level'|trans }}</h2>
    <ul class="table-picker table-picker--levels">
        {% for row in grid %}
            {% set round = row.rounds|filter(round => round.operation == operation)|first %}
            {% set level_key = 'game.rekenen.erbij_eraf.levels.' ~ row.level.key %}
            <li>
                <a class="table-picker__link" href="{{ path('app_game_rekenen_erbij_eraf_spel', {level: row.level.slug, operation: operation.value}) }}">
                    <span class="table-picker__label">{{ (level_key ~ '.name')|trans }}</span>
                    <span class="table-picker__note">{{ (level_key ~ '.' ~ example_keys[operation.value])|trans }}</span>
                    {% if progress[round.stored] is defined %}
                        {{ include('player/_progress_badge.html.twig', {result: progress[round.stored], compact: true}) }}
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>

    <p class="table-picker__back">
        <a class="action-button action-button--secondary action-button--small" href="{{ path('app_game_rekenen') }}">
            <span aria-hidden="true">←</span> {{ 'game.rekenen.back'|trans }}
        </a>
    </p>
{% endblock %}
