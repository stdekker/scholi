{% extends 'base.html.twig' %}

{% block title %}{{ 'game.rekenen.title'|trans }} – {{ parent() }}{% endblock %}

{% block body %}
    <h1>{{ 'game.rekenen.title'|trans }}</h1>
    <p>{{ 'game.rekenen.intro'|trans }}</p>

    <ul class="game-list">
        <li>
            <a class="game-card" href="{{ path('app_game_rekenen_tafels') }}">
                <span class="game-card__title">{{ 'game.rekenen.tafels.name'|trans }}</span>
                <span class="game-card__description">{{ 'game.rekenen.tafels.description'|trans }}</span>
            </a>
        </li>
        <li>
            <a class="game-card" href="{{ path('app_game_rekenen_erbij_eraf') }}">
                <span class="game-card__title">{{ 'game.rekenen.erbij_eraf.name'|trans }}</span>
                <span class="game-card__description">{{ 'game.rekenen.erbij_eraf.description'|trans }}</span>
            </a>
        </li>
    </ul>
{% endblock %}
