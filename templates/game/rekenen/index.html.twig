{% extends 'base.html.twig' %}

{% block title %}{{ 'game.rekenen.title'|trans }} – {{ parent() }}{% endblock %}

{% block body %}
    <h1>{{ 'game.rekenen.title'|trans }}</h1>
    <p>{{ 'game.rekenen.intro'|trans }}</p>

    <ul class="table-picker">
        {% for table in tables %}
            <li>
                <a class="table-picker__link" href="{{ path('app_game_rekenen_tafel', {table: table}) }}">
                    {{ 'game.rekenen.table'|trans({'%table%': table}) }}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
