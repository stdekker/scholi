{% extends 'base.html.twig' %}

{% block title %}{{ 'game.rekenen.title'|trans }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# Badges change after every round; never show a stale copy from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <h1>{{ 'game.rekenen.title'|trans }}</h1>
    <p>{{ 'game.rekenen.intro'|trans }}</p>

    <ul class="table-picker">
        {% for table in tables %}
            <li>
                <a class="table-picker__link" href="{{ path('app_game_rekenen_tafel', {table: table}) }}">
                    <span class="table-picker__label">{{ 'game.rekenen.table'|trans({'%table%': table}) }}</span>
                    {% if progress[table] is defined %}
                        {{ include('player/_progress_badge.html.twig', {result: progress[table], compact: true}) }}
                    {% endif %}
                </a>
            </li>
        {% endfor %}
        <li class="table-picker__item--all">
            <a class="table-picker__link table-picker__link--all" href="{{ path('app_game_rekenen_alle') }}">
                <span class="table-picker__label">{{ 'game.rekenen.all_tables'|trans }}</span>
                {% if progress[all_tables] is defined %}
                    {{ include('player/_progress_badge.html.twig', {result: progress[all_tables], compact: true}) }}
                {% endif %}
            </a>
        </li>
    </ul>
{% endblock %}
