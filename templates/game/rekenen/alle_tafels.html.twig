{% extends 'base.html.twig' %}

{# A task selection screen: the elephant mascot sits in the bottom right corner. #}
{% set mascot = true %}

{% block title %}{{ 'game.rekenen.mixes.title'|trans }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# Badges and the practised tables change after every round; never show a stale copy from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <h1>{{ 'game.rekenen.mixes.title'|trans }}</h1>
    <p>{{ 'game.rekenen.mixes.intro'|trans }}</p>

    <ul class="table-picker table-picker--mixes">
        {% for mix in mixes %}
            {{ include('game/_picker_tile.html.twig', {
                url: path('app_game_rekenen_mix', {mix: mix.slug}),
                label: 'game.rekenen.mixes.range'|trans({'%last%': mix.lastTable}),
                result: progress[mix.value] ?? null,
            }, with_context = false) }}
        {% endfor %}
        <li>
            {% if practised_open %}
                <a class="table-picker__link" href="{{ path('app_game_rekenen_geoefend') }}">
                    <span class="table-picker__label">{{ 'game.rekenen.mixes.practised'|trans }}</span>
                    <span class="table-picker__note">{{ practised|join(', ') }}</span>
                </a>
            {% else %}
                {# Not a link yet: 20 different sums need at least two finished tables. #}
                <p class="table-picker__link table-picker__link--locked">
                    <span class="table-picker__label">{{ 'game.rekenen.mixes.practised'|trans }}</span>
                    <span class="table-picker__note">{{ 'game.rekenen.mixes.practised_locked'|trans }}</span>
                </p>
            {% endif %}
        </li>
    </ul>

    <p class="table-picker__back">
        <a class="action-button action-button--secondary action-button--small" href="{{ path('app_game_rekenen_tafels') }}">
            <span aria-hidden="true">←</span> {{ 'game.rekenen.mixes.back'|trans }}
        </a>
    </p>
{% endblock %}
