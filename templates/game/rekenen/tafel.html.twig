{% extends 'game/bubble_game.html.twig' %}

{#
    One template for a single table (table, 1–12) and for "alle tafels": a fixed mix (mix) or the
    practised tables (practised).
#}
{% set controller = 'tafels' %}
{% set values = {tables: tables} %}
{% set is_mix = table is null %}
{% if practised %}
    {% set title = 'game.rekenen.mixes.practised'|trans %}
    {% set intro = 'game.rekenen.tafels.all.intro_practised'|trans %}
{% elseif mix %}
    {% set title = 'game.rekenen.mixes.range'|trans({'%last%': mix.lastTable}) %}
    {% set intro = 'game.rekenen.tafels.all.intro'|trans({'%last%': mix.lastTable}) %}
{% else %}
    {% set title = 'game.rekenen.tafels.title'|trans({'%table%': table}) %}
    {% set intro = 'game.rekenen.tafels.intro'|trans %}
{% endif %}
{% set passed_message = is_mix ? 'game.rekenen.tafels.all.done'|trans : 'game.rekenen.tafels.done'|trans({'%table%': table}) %}
{% set back_label = (is_mix ? 'game.rekenen.tafels.other_mix' : 'game.rekenen.tafels.other_table')|trans %}
