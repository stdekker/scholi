{% extends 'base.html.twig' %}

{% set title = 'game.rekenen.tafels.title'|trans({'%table%': table}) %}

{% block title %}{{ title }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# The board is built by JS; never restore a half-played round from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <section class="bubble-game"
        data-controller="tafels"
        data-tafels-table-value="{{ table }}"
        data-tafels-time-limit-value="{{ time_limit_ms }}"
        data-tafels-save-url-value="{{ app.user ? path('app_game_rekenen_tafel_result', {table: table}) : '' }}"
        data-tafels-sum-label-value="{{ 'game.rekenen.tafels.sum_label'|trans }}"
        data-tafels-correct-value="{{ 'game.rekenen.tafels.correct'|trans }}"
        data-tafels-try-again-value="{{ 'game.rekenen.tafels.try_again'|trans }}"
        data-tafels-remaining-value="{{ 'game.rekenen.tafels.remaining'|trans }}"
        data-tafels-time-up-value="{{ 'game.rekenen.tafels.timer.up'|trans }}"
        data-tafels-go-value="{{ 'game.rekenen.tafels.ready.go'|trans }}"
        data-action="keydown@window->tafels#typeAnywhere"
    >
        {# Shown before every round; the clock starts after the 3-2-1 countdown. #}
        <dialog class="ready-dialog" aria-labelledby="ready-dialog-title" closedby="none"
            data-tafels-target="readyDialog"
            data-action="cancel->tafels#preventCancel close->tafels#readyClosed">
            <h2 class="ready-dialog__title" id="ready-dialog-title">{{ 'game.rekenen.tafels.ready.title'|trans }}</h2>
            <p class="ready-dialog__time">
                <span class="ready-dialog__time-label">{{ 'game.rekenen.tafels.timer.label'|trans }}</span>
                <span data-tafels-target="readyTime">1:00</span>
            </p>
            <p>{{ 'game.rekenen.tafels.ready.text'|trans }}</p>
            <button type="button" class="action-button ready-dialog__button"
                data-tafels-target="readyButton" data-action="tafels#ready">
                {{ 'game.rekenen.tafels.ready.button'|trans }}
            </button>
            <p class="ready-dialog__countdown" role="status" data-tafels-target="countdown"></p>
        </dialog>

        <header class="bubble-game__header">
            <h1>{{ title }}</h1>
            <p>{{ 'game.rekenen.tafels.intro'|trans }}</p>
            <div class="bubble-game__meta">
                <p class="bubble-game__progress" data-tafels-target="progress"></p>
                <div class="round-timer" data-tafels-target="timer">
                    <span class="round-timer__label">{{ 'game.rekenen.tafels.timer.label'|trans }}</span>
                    <span class="round-timer__time" role="timer" data-tafels-target="time">1:00</span>
                    <span class="round-timer__bar" aria-hidden="true"><span class="round-timer__fill"></span></span>
                </div>
            </div>
        </header>

        <ul class="bubble-field" data-tafels-target="field"></ul>

        <template data-tafels-target="bubbleTemplate">
            <li class="bubble">
                <button type="button" class="bubble__sum" data-action="tafels#open">
                    <span class="bubble__question"></span>
                    <span class="bubble__placeholder" aria-hidden="true">…</span>
                </button>
                <input type="text" class="bubble__answer"
                    inputmode="none" maxlength="3" autocomplete="off"
                    aria-label="{{ 'game.rekenen.tafels.answer'|trans }}"
                    data-action="input->tafels#typed keydown->tafels#keydown" hidden>
            </li>
        </template>

        {# Sticky dock: feedback and keypad stay in view while answering. #}
        <div class="bubble-game__dock">
            <p class="bubble-game__status" role="status" data-tafels-target="status"></p>

            <div class="keypad" data-tafels-target="keypad" hidden>
                {% for digit in [1, 2, 3, 4, 5, 6, 7, 8, 9] %}
                    <button type="button" class="keypad__key" data-action="tafels#press" data-tafels-digit-param="{{ digit }}">{{ digit }}</button>
                {% endfor %}
                <button type="button" class="keypad__key keypad__key--erase" data-action="tafels#erase"
                    aria-label="{{ 'game.rekenen.tafels.keypad.erase'|trans }}">⌫</button>
                <button type="button" class="keypad__key" data-action="tafels#press" data-tafels-digit-param="0">0</button>
                <button type="button" class="keypad__key keypad__key--check" data-action="tafels#submit">{{ 'game.rekenen.tafels.keypad.check'|trans }}</button>
            </div>
        </div>

        <div class="round-complete" data-tafels-target="complete" hidden>
            <p class="round-complete__message" data-tafels-target="passedMessage">{{ 'game.rekenen.tafels.done'|trans({'%table%': table}) }}</p>
            <p class="round-complete__message" data-tafels-target="lateMessage" hidden>{{ 'game.rekenen.tafels.done_late'|trans({'%table%': table}) }}</p>
            {% if app.user %}
                <p class="round-complete__note" data-tafels-target="savedMessage" hidden>{{ 'game.rekenen.tafels.saved'|trans }}</p>
                <p class="round-complete__note" data-tafels-target="saveFailedMessage" hidden>{{ 'game.rekenen.tafels.save_failed'|trans }}</p>
            {% else %}
                <p class="round-complete__note">
                    {{ 'game.rekenen.tafels.guest'|trans }}
                    <a href="{{ path('app_player_new') }}">{{ 'game.rekenen.tafels.guest_link'|trans }}</a>
                </p>
            {% endif %}
            <div class="round-complete__actions">
                <button type="button" class="action-button" data-action="tafels#restart" data-tafels-target="restart">
                    {{ 'game.rekenen.tafels.again'|trans }}
                </button>
                <a class="action-button action-button--secondary" href="{{ path('app_game_rekenen') }}">
                    {{ 'game.rekenen.tafels.other_table'|trans }}
                </a>
            </div>
        </div>
    </section>
{% endblock %}
