{% extends 'base.html.twig' %}

{# A task selection screen: the elephant mascot sits in the bottom right corner. #}
{% set mascot = true %}

{#
    Two simple choices on one page: first the groep (links that reload the page with ?groep=…,
    so no JS is needed), then one of the four levels for that groep.
#}

{% block title %}{{ 'game.taal.dictee.name'|trans }} – {{ parent() }}{% endblock %}

{% block meta %}
    {# Badges change after every round; never show a stale copy from Turbo's cache. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <h1>{{ 'game.taal.dictee.name'|trans }}</h1>
    <p>{{ 'game.taal.dictee.picker_intro'|trans }}</p>

    <h2 class="picker-step">{{ 'game.taal.dictee.choose_group'|trans }}</h2>
    <ul class="operation-switch">
        {% for choice in groups %}
            <li>
                <a class="operation-switch__link" href="{{ path('app_game_taal_dictee', {groep: choice.value}) }}"
                    {%- if choice == group %} aria-current="page"{% endif %}>
                    {{ ('game.taal.dictee.groups.' ~ choice.key)|trans }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <h2 class="picker-step">{{ 'game.taal.dictee.choose_level'|trans }}</h2>
    <ul class="table-picker table-picker--levels table-picker--pairs">
        {% for row in grid %}
            {% set round = row.rounds|filter(round => round.group == group)|first %}
            {% set level_key = 'game.taal.dictee.levels.' ~ row.level.key %}
            <li>
                <a class="table-picker__link" href="{{ path('app_game_taal_dictee_spel', {group: group.slug, level: row.level.slug}) }}">
                    <span class="table-picker__label">{{ (level_key ~ '.name')|trans }}</span>
                    <span class="table-picker__note">{{ (level_key ~ '.description')|trans }}</span>
                    {% if progress[round.stored] is defined %}
                        {{ include('player/_progress_badge.html.twig', {result: progress[round.stored], compact: true}) }}
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>

    <p class="table-picker__back">
        <a class="action-button action-button--secondary action-button--small" href="{{ path('app_game_taal') }}">
            <span aria-hidden="true">←</span> {{ 'game.taal.back'|trans }}
        </a>
    </p>
{% endblock %}
