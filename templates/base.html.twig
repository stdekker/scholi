<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}{% endblock %}
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧮</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a class="site-header__brand" href="{{ path('app_home') }}">{{ 'app.name'|trans }}</a>
            {% if app.user %}
                {% set stats = player_stats(app.user) %}
                <a class="site-header__player" href="{{ path('app_player') }}">
                    {# On phones only the emoji shows (or 👤 for players from before emoji); the name is visually hidden. #}
                    <span class="site-header__name">
                        {%- if app.user.emoji is null -%}
                            <span class="site-header__icon" aria-hidden="true">👤</span> <span class="site-header__label">{{ app.user.name }}</span>
                        {%- else -%}
                            <span class="site-header__label">{{ app.user.name }}</span> <span class="site-header__icon">{{ app.user.emoji }}</span>
                        {%- endif -%}
                    </span>
                    {# Badges (⭐ and ✓ over all games) and minutes practised in the last seven days. #}
                    <span class="site-header__stats" aria-hidden="true">
                        <span>⭐ {{ stats.badges }}</span>
                        <span>⏱️ {{ 'player.header.minutes'|trans({'%minutes%': stats.minutes}) }}</span>
                    </span>
                    <span class="visually-hidden">{{ 'player.header.stats'|trans({'%badges%': stats.badges, '%minutes%': stats.minutes}) }}</span>
                </a>
            {% else %}
                <a class="site-header__player" href="{{ path('app_player_new') }}">{{ 'player.header.save_progress'|trans }}</a>
            {% endif %}
        </header>
        <div class="about-popover" id="about-scholi" popover role="dialog" aria-labelledby="about-scholi-title">
            <img class="about-popover__logo" src="{{ asset('images/scholi-mascot.webp') }}" alt="" width="96" height="96">
            <h2 class="about-popover__title" id="about-scholi-title">{{ 'app.about.title'|trans }}</h2>
            <p>{{ 'app.about.text'|trans }}</p>
            <div class="about-popover__actions">
                {# A plain link, nothing is loaded from GitHub. It opens a new tab, so a running game is not left. #}
                <a class="action-button action-button--secondary" href="{{ github_url }}" target="_blank" rel="noopener noreferrer">
                    {# The GitHub mark, inline (no request); decorative, the text says it. #}
                    <svg class="about-popover__icon" viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    {{ 'app.about.github'|trans }}
                    <span class="visually-hidden">{{ 'app.about.new_tab'|trans }}</span>
                </a>
                <button type="button" class="action-button" popovertarget="about-scholi" popovertargetaction="hide">{{ 'app.about.close'|trans }}</button>
            </div>
        </div>
        <main class="site-main">
            {% block body %}{% endblock %}
        </main>
        {# Bottom-left of the page (not fixed, so it never covers the game). Native popover: no JS needed. #}
        <footer class="site-footer">
            <button type="button" class="about-button" popovertarget="about-scholi">
                <span aria-hidden="true">ℹ️</span> {{ 'app.about.button'|trans }}
            </button>
            {# Bottom right corner, on task selection screens only: they set `mascot` to true. Never in a game. #}
            {% if mascot is defined and mascot %}
                <img class="site-footer__mascot" src="{{ asset('images/scholi-mascot-large.webp') }}" alt="" width="192" height="192">
            {% endif %}
        </footer>
    </body>
</html>
