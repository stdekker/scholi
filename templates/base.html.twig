<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}{% endblock %}
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧮</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a class="site-header__brand" href="{{ path('app_home') }}">{{ 'app.name'|trans }}</a>
            <div class="site-header__actions">
            {% if app.user %}
                <a class="site-header__player" href="{{ path('app_player') }}">
                    {% if app.user.emoji is null %}<span aria-hidden="true">👤</span>{% endif %} {{ app.user.displayName }}
                </a>
            {% else %}
                <a class="site-header__player" href="{{ path('app_player_new') }}">{{ 'player.header.save_progress'|trans }}</a>
            {% endif %}
                {# Native popover: opens and closes without JS. #}
                <button type="button" class="site-header__player site-header__about" popovertarget="about-scholi">
                    <span aria-hidden="true">ℹ️</span>
                    <span class="site-header__about-label">{{ 'app.about.button'|trans }}</span>
                </button>
            </div>
        </header>
        <div class="about-popover" id="about-scholi" popover role="dialog" aria-labelledby="about-scholi-title">
            <h2 class="about-popover__title" id="about-scholi-title">{{ 'app.about.title'|trans }}</h2>
            <p>{{ 'app.about.text'|trans }}</p>
            <button type="button" class="action-button" popovertarget="about-scholi" popovertargetaction="hide">{{ 'app.about.close'|trans }}</button>
        </div>
        <main class="site-main">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
