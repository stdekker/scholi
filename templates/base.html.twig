<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}{% endblock %}
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧮</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a class="site-header__brand" href="{{ path('app_home') }}">{{ 'app.name'|trans }}</a>
            {% if app.user %}
                {% set stats = player_stats(app.user) %}
                <a class="site-header__player" href="{{ path('app_player') }}">
                    {# On phones only the emoji shows (or 👤 for players from before emoji); the name is visually hidden. #}
                    <span class="site-header__name">
                        {%- if app.user.emoji is null -%}
                            <span class="site-header__icon" aria-hidden="true">👤</span> <span class="site-header__label">{{ app.user.name }}</span>
                        {%- else -%}
                            <span class="site-header__label">{{ app.user.name }}</span> <span class="site-header__icon">{{ app.user.emoji }}</span>
                        {%- endif -%}
                    </span>
                    {# Badges (⭐ and ✓ over all games) and minutes practised in the last seven days. #}
                    <span class="site-header__stats" aria-hidden="true">
                        <span>⭐ {{ stats.badges }}</span>
                        <span>⏱️ {{ 'player.header.minutes'|trans({'%minutes%': stats.minutes}) }}</span>
                    </span>
                    <span class="visually-hidden">{{ 'player.header.stats'|trans({'%badges%': stats.badges, '%minutes%': stats.minutes}) }}</span>
                </a>
            {% else %}
                <a class="site-header__player" href="{{ path('app_player_new') }}">{{ 'player.header.save_progress'|trans }}</a>
            {% endif %}
        </header>
        <div class="about-popover" id="about-scholi" popover role="dialog" aria-labelledby="about-scholi-title">
            <h2 class="about-popover__title" id="about-scholi-title">{{ 'app.about.title'|trans }}</h2>
            <p>{{ 'app.about.text'|trans }}</p>
            <button type="button" class="action-button" popovertarget="about-scholi" popovertargetaction="hide">{{ 'app.about.close'|trans }}</button>
        </div>
        <main class="site-main">
            {% block body %}{% endblock %}
        </main>
        {# Bottom-left of the page (not fixed, so it never covers the game). Native popover: no JS needed. #}
        <footer class="site-footer">
            <button type="button" class="about-button" popovertarget="about-scholi">
                <span aria-hidden="true">ℹ️</span> {{ 'app.about.button'|trans }}
            </button>
        </footer>
    </body>
</html>
